{
  "name": "echo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "yarn@4.2.1",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "start:local": "PORT=3000 node server-local-https.js",
    "release": "standard-version",
    "lint": "next lint --fix"
  },
  "dependencies": {
    "components": "workspace:*"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
