{
  "name": "storybook",
  "private": true,
  "version": "1.0.0",
  "description": "Storybook host for component and page stories across the monorepo.",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --project=storybook"
  },
  "installConfig": {
