# Need this for the production build, but can be commented out for local development so the `mockServiceWorker.js` will load.
#PUBLIC_URL=/wp-content/reactpress/apps/svt-trading-tools/build

REACT_APP_SVT_WORDPRESS_API_URL='http://localhost:3031/wp-json/'
REACT_APP_SVT_BACKEND_API_ACCESSS_TOKEN='your-api-access-token-here'
REACT_APP_SVT_BACKEND_API_URL='http://localhost:5000'
REACT_APP_MOCK_BACKEND_API=true

# Login details for development. Don't forget to escape any dollar signs.
REACT_APP_SVT_USER='user@example.com'
REACT_APP_SVT_PASS='your-pass-here'

# DxFeed Auth Token Details:
DXFEED_IPF_USERNAME=username
DXFEED_IPF_PASSWORD=password
REACT_APP_DXFEED_ISSUER='issuer-here'
REACT_APP_DXFEED_MESSAGE='message-here'
REACT_APP_DXFEED_SECRET='secret-here'

# Needed until this is merged: https://github.com/facebook/create-react-app/pull/11752
# @see https://github.com/facebook/create-react-app/discussions/11767
GENERATE_SOURCEMAP=false
