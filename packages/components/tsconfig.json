{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist/types",
    "noUnusedLocals": false,
    "incremental": true,
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
