{
  "name": "tda-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "yarn@4.2.1",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "start:local": "PORT=3000 node server-local-https.js",
    "release": "standard-version",
    "lint": "next lint --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.16.1",
    "@mui/x-date-pickers-pro": "^7.10.0",
    "components": "workspace:*"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
