{
  "name": "tda-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "yarn@4.2.1",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "start:local": "PORT=3000 node server-local-https.js",
    "release": "standard-version",
    "lint": "next lint --fix",
    "test": "jest"
  },
  "dependencies": {
    "@mui/x-date-pickers-pro": "^7.10.0",
    "components": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
