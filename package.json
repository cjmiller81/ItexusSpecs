    "build:svt": "lerna run build --stream --scope svt-app",
    "start:svt": "lerna run start --scope svt-app",
    "prepare": "husky install",
    "storybook": "lerna run storybook --scope components",
    "build:storybook": "lerna run build-storybook --stream --scope components"
  },
