{
  "name": "echo-ui",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev:ei": "lerna run dev --scope ei-app",
    "build:ei": "lerna run build --scope ei-app",
    "start:ei": "lerna run start --scope ei-app",
    "lint:ei": "lerna run lint --scope ei-app",
    "build:svt": "lerna run build --scope svt-app",
    "start:svt": "lerna run start --scope svt-app",
    "prepare": "husky install",
    "storybook": "lerna run storybook --scope components",
    "build:storybook": "lerna run build-storybook --scope components"
  },
  "workspaces": {
    "packages": ["packages/*"],
    "nohoist": [
      "**/ei-app",
      "**/ei-app/**",
      "**/svt-app",
      "**/svt-app/**"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "husky": "^7.0.4",
    "lerna": "^8.1.2",
    "prettier": "2.6.2"
  }
}
