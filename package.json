  "scripts": {
    "watch:comp": "lerna watch --scope=components -- lerna run build --scope=components",
    "build:comp": "lerna run build --scope components",
    "dev:ei": "lerna run dev --parallel --scope ei-app --scope components",
    "build:ei": "lerna run build --stream --scope ei-app --include-filtered-dependencies",
